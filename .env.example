DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=codebase_agent
POSTGRES_USER=codebase_agent
POSTGRES_PASSWORD=codebase_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

REPO_CACHE_ROOT=./repos-cache
SAFE_LOCAL_REPO_ROOTS=./,./repos-cache

AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=24
AGENT_TOOL_TIMEOUT_SECONDS=8
AGENT_SEARCH_MAX_RESULTS=25
AGENT_READ_MAX_LINES=150
